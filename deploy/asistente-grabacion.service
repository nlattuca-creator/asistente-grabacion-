[Unit]
Description=asistente-grabacion (audio-companion) backend + frontend
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/asistente-grabacion/backend
EnvironmentFile=-/opt/asistente-grabacion/backend/.env
ExecStart=/opt/asistente-grabacion/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
